{
  "name": "dsh-dot",
  "version": "1.0.0",
  "description": "Resident agent entity for DeepSeek Harness: bots that live outside any session, with their own instances, file-based memory you can open and edit, a task queue, an approval gate, and an optional background executor. Ships no platform integrations.",
  "type": "module",
  "main": "entry.js",
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "entry.js",
    "impl.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/avatar-128.png",
    "assets/avatar-256.png",
    "assets/LICENSE",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-client-wiring.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "resident",
    "memory",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wqty123/dsh-dot.git"
  },
  "homepage": "https://github.com/wqty123/dsh-dot",
  "bugs": {
    "url": "https://github.com/wqty123/dsh-dot/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.1.1-rc.2": "unknown",
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible"
      }
    }
  }
}
